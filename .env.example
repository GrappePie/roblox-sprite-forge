# La aplicación escucha únicamente en tu PC por defecto.
HOST=127.0.0.1
PORT=3000

# Servidor local de ComfyUI. No utiliza ninguna clave de API.
COMFYUI_URL=http://127.0.0.1:8188

# Captura opcional del avatar 3D real desde Roblox Studio mediante el plugin MCP.
# Si Studio no está abierto/conectado, el generador vuelve automáticamente a la miniatura web.
ROBLOX_STUDIO_CAPTURE=true
ROBLOX_STUDIO_MCP_URL=http://127.0.0.1:58741
# Vacío usa %USERPROFILE%/.robloxstudio-mcp/auth-token.
# ROBLOX_STUDIO_MCP_TOKEN_PATH=C:\Users\tu_usuario\.robloxstudio-mcp\auth-token
ROBLOX_STUDIO_CAPTURE_FORMAT=jpeg
ROBLOX_STUDIO_CAPTURE_QUALITY=96

# Nombres exactos dentro de ComfyUI/models/.
COMFYUI_UNET=flux-2-klein-4b-fp8.safetensors
COMFYUI_TEXT_ENCODER=qwen_3_4b.safetensors
COMFYUI_VAE=flux2-vae.safetensors
COMFYUI_WEIGHT_DTYPE=default
COMFYUI_ANIMATION_CHECKPOINT=PixelartSpritesheet_V.1.ckpt
COMFYUI_ANIMATION_CONTROLNET=control_v11p_sd15_openpose.pth

# Motor de animacion SD 1.5 + OpenPose. La pose se impone sobre un sprite maestro.
ANIMATION_ENGINE=deterministic
ANIMATION_STEPS=20
ANIMATION_CFG=7
ANIMATION_DENOISE=0.72
ANIMATION_CONTROL_STRENGTH=1.15

# Valores iniciales de la interfaz.
DEFAULT_RENDER_RESOLUTION=512
DEFAULT_CELL_SIZE=64
DEFAULT_PALETTE_COLORS=64
DEFAULT_STYLE=handheld
DEFAULT_STEPS=4
DEFAULT_FRAMES_PER_ANIMATION=8

# Un frame puede tardar varios minutos al cargar el modelo por primera vez.
FRAME_TIMEOUT_MS=900000
COMFYUI_POLL_MS=800

# La cola procesa un solo trabajo a la vez para cuidar la VRAM.
MAX_QUEUED_JOBS=8
JOB_RETENTION_HOURS=24

# Cancelar interrumpe el workflow activo de ComfyUI.
COMFYUI_INTERRUPT_ON_CANCEL=true

# true conserva las salidas grandes sin procesar de ComfyUI.
KEEP_RAW_FRAMES=false

# Carpeta de resultados, relativa al proyecto o absoluta.
OUTPUT_DIR=data/generated
